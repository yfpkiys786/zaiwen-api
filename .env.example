# ===========================================
#  在问AI API 配置文件
#  使用方法: cp .env.example .env  然后编辑 .env
# ===========================================

# 服务端口 (Render 上留空，本地用 3456)
PORT=3456

# 初始 Token 列表，多个用英文逗号分隔
# 部署后可用 /v1/admin/tokens 接口增删，无需重新部署
TOKENS=你的token1,你的token2

# 最低余额，低于此值自动跳过该token
MIN_BALANCE=100

# 管理接口密钥 (用于保护 /v1/admin/* 接口)
# 请改成你自己的随机字符串
ADMIN_KEY=请修改此密钥
