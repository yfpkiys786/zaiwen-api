# ===========================================
#  在问AI API 配置文件
#  使用方法: cp .env.example .env  然后编辑 .env
# ===========================================

# 服务端口 (Render 上不填，本地用 3456)
PORT=3456

# 初始 Token 列表，多个用英文逗号分隔
# 仅首次部署用到，之后全部通过 /v1/admin/tokens 接口管理
TOKENS=你的token1,你的token2

# 最低余额，低于此值自动跳过该token
MIN_BALANCE=100

# 管理接口密钥 (保护 /v1/admin/* 接口)
ADMIN_KEY=请修改此密钥

# Redis 连接 (token 持久化，重启不丢)
# 格式: redis://user:password@host:port
REDIS_URL=redis://default:密码@主机:端口
